{
    "preset": "laravel",
    "rules": {
        "concat_space": { "spacing": "one" },
        "not_operator_with_successor_space": false,
        "single_line_empty_body": false,
        "function_declaration": {
            "closure_function_spacing": "none",
            "closure_fn_spacing": "none"
        }
    }
}
