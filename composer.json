{
    "name": "topmenu/laravel-postman-sync",
    "description": "Build a Postman collection from your Laravel routes and publish it to a Postman workspace",
    "keywords": ["laravel", "postman", "api", "documentation"],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "TopMenu\\PostmanSync\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TopMenu\\PostmanSync\\PostmanSyncServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
